# ============================================
# SECRETS TEMPLATE - EXAMPLE
# ============================================
# Copy this file to secrets-template.yaml and fill in your actual secrets
# 
# IMPORTANT: secrets-template.yaml is in .gitignore and should NEVER be committed to Git!
#
# To generate random secrets:
#   openssl rand -base64 32
#
# After filling in values, seal them with:
#   ./seal-secrets.sh
#
---
apiVersion: v1
kind: Secret
metadata:
  name: osaan-ui-secret
  namespace: osaan-dev
type: Opaque
stringData:
  # NextAuth.js session secret (generate with: openssl rand -base64 32)
  NEXTAUTH_SECRET: "CHANGE-ME-generate-a-random-32-char-string"
  
  # Keycloak OIDC client secret (must match Keycloak client configuration)
  KEYCLOAK_CLIENT_SECRET: "osaan-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: osaan-admin-backend-secret
  namespace: osaan-dev
type: Opaque
stringData:
  # Express session secret (generate with: openssl rand -base64 32)
  SESSION_SECRET: "CHANGE-ME-generate-a-random-32-char-string"
  
  # Keycloak OIDC client secret (must match Keycloak client configuration)
  KEYCLOAK_CLIENT_SECRET: "osaan-admin-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: osaan-dev
type: Opaque
stringData:
  # Redis password (choose a strong password)
  redis-password: "CHANGE-ME-redis-password"
