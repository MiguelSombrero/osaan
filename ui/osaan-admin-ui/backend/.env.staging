# Production-like environment variables for staging deployment
NODE_ENV=staging
PORT=3001
NODE_TLS_REJECT_UNAUTHORIZED=0
TARGET_API=http://skill-catalog-service:8080
SESSION_COOKIE_SECURE=false
SESSION_SECRET=mysecret
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:8085
REDIS_ENABLED=true
REDIS_HOST=osaan-redis
REDIS_PORT=6379
BASE_URL=http://localhost:3001
LOGIN_REDIRECT_URL=http://localhost:8085/skills
LOGOUT_REDIRECT_URL=http://localhost:8085
KEYCLOAK_ENABLED=true
KEYCLOAK_ISSUER_BASE_URL=https://keycloak:8443/realms/osaan
KEYCLOAK_CLIENT_ID=osaan-admin-ui
KEYCLOAK_CLIENT_SECRET=osaan-admin-secret