# App Configuration
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Keycloak Configuration
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=http://localhost:8080/realms/osaan
KEYCLOAK_CLIENT_ID=osaan-ui
KEYCLOAK_CLIENT_SECRET=

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Microservice API URLs (server-side only)
SKILL_CATALOG_API_URL=http://localhost:8092
EMPLOYEE_API_URL=http://localhost:8091
COMPETENCE_PROFILE_API_URL=http://localhost:8093
COMPETENCE_MATCHING_API_URL=http://localhost:8094
