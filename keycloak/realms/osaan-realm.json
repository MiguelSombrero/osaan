      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3002/*",
        "https://localhost:3000/*",
        "https://localhost:3002/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3002",
        "https://localhost:3000",
        "https://localhost:3002"
      ],
      "publicClient": false,
      "bearerOnly": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3002/*##https://localhost:3000/*##https://localhost:3002/*"
      }
    },
    {
      "clientId": "osaan-admin-ui",
