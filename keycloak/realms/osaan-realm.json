{
  "id": "osaan",
  "realm": "osaan",
  "displayName": "Osaan",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator role for Osaan"
      },
      {
        "name": "MANAGER",
        "description": "Manager or project leader role for Osaan"
      },
      {
        "name": "USER",
        "description": "Regular user role for Osaan"
      }
    ]
  },
  "clients": [
    {
      "clientId": "osaan-ui",
      "name": "Osaan UI",
      "secret": "osaan-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3002/*",
        "https://localhost:3000/*",
        "https://localhost:3002/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3002",
        "https://localhost:3000",
        "https://localhost:3002"
      ],
      "publicClient": false,
      "bearerOnly": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3002/*##https://localhost:3000/*##https://localhost:3002/*"
      }
    },
    {
      "clientId": "osaan-admin-ui",
      "name": "Osaan Admin UI",
      "secret": "osaan-admin-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:3000/*",
        "http://localhost:8085/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:8085",
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "publicClient": false,
      "bearerOnly": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8085/*##http://localhost:3000/*##http://localhost:3001/*##http://keycloak:8443/*"
      }
    },
    {
      "clientId": "osaan-swagger",
      "name": "Osaan Swagger",
      "secret": "osaan-swagger-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:8092/swagger-ui/*"],
      "webOrigins": ["http://localhost:8092"],
      "publicClient": false,
      "bearerOnly": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8092/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Regular",
      "lastName": "User",
      "email": "user@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": ["USER"]
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Manager",
      "lastName": "User",
      "email": "manager@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": ["MANAGER"]
    }
  ]
}
