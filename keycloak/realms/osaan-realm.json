      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:3000/*",
        "http://localhost:8085/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:8085",
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "publicClient": false,
      "bearerOnly": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8085/*##http://localhost:3000/*##http://localhost:3001/*##http://keycloak:8443/*"
      }
    },
    {
      "clientId": "osaan-swagger",
      "name": "Osaan Swagger",
      "secret": "osaan-swagger-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:8092/swagger-ui/*"],
      "webOrigins": ["http://localhost:8092"],
      "publicClient": false,
      "bearerOnly": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8092/*"
      }
    }
